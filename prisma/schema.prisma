generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Scene {
  id          String    @id @default(cuid())
  title       String
  category    String    @default("memes") // movies | memes | politics
  s3Key       String    // scenes/scene1.mp4 - original video
  s3KeyCuts   String?   // scenes/scene1_cuts.mp4 - video with audio cut at cue ranges
  durationSec Float
  fps         Float     @default(25)  // frames per second
  rolesCount  Int
  cueJson     String    // JSON: [{roleIndex, startFrame, durationFrames}] - stored in frames!
  createdAt   DateTime  @default(now())
  sessions    Session[]

  @@index([category])
}

model Session {
  id              String        @id @default(cuid())
  category        String        @default("memes") // movies | memes | politics
  gameMode        String        @default("improv") // improv | tasks
  task            String?       // Only set if gameMode = "tasks"
  status          String        @default("lobby") // lobby | recording | rendering | ready
  sceneId         String
  scene           Scene         @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  maxPlayers      Int
  createdByTgUserId String
  createdAt       DateTime      @default(now())
  participants    Participant[]
  takes           Take[]
  render          Render?
  skipCount       Int           @default(0)
  
  // Replay request for multiplayer confirmation
  // JSON: { requestedBy: string, mode: "sameScene" | "newScene", requestedAt: string }
  replayRequest   String?       // null = no pending request

  @@index([createdByTgUserId])
  @@index([status])
  @@index([category])
}

model Participant {
  id          String   @id @default(cuid())
  sessionId   String
  session     Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  tgUserId    String
  displayName String
  roleIndex   Int
  joinedAt    DateTime @default(now())

  @@unique([sessionId, tgUserId])
  @@unique([sessionId, roleIndex])
  @@index([tgUserId])
}

model Take {
  id          String   @id @default(cuid())
  sessionId   String
  session     Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  roleIndex   Int
  s3Key       String   // uploads/<sessionId>/<roleIndex>.webm
  durationSec Float
  createdAt   DateTime @default(now())

  @@unique([sessionId, roleIndex])
}

model Render {
  id           String   @id @default(cuid())
  sessionId    String   @unique
  session      Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  status       String   @default("pending") // pending | rendering | ready | failed
  s3Key        String?  // renders/<sessionId>.mp4
  error        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  sends        RenderSend[]
}

model RenderSend {
  id              String   @id @default(cuid())
  renderId        String
  render          Render   @relation(fields: [renderId], references: [id], onDelete: Cascade)
  telegramUserId  String
  status          String   @default("queued") // queued | sending | sent | failed | too_large | rate_limited
  error           String?  // краткая причина ошибки отправки
  attempts        Int      @default(0)
  retryAfterSeconds Int?   // retry_after в секундах (для rate_limited)
  updatedAt       DateTime @updatedAt

  @@unique([renderId, telegramUserId])
  @@index([renderId])
  @@index([telegramUserId])
}
